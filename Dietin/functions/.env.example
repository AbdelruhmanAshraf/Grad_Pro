# =========================================================================
# Dietin Firebase Cloud Functions — secrets template
# Copy to functions/.env and fill values. NEVER COMMIT functions/.env.
# Loaded automatically by firebase-functions v2 / functions emulator.
# For deploy, set with: firebase functions:secrets:set <NAME>
# =========================================================================

# --- Gemini ------------------------------------------------------------------
# Server-side only. Used by analyze_food, analyze_image_food, and other
# proxy endpoints. Never expose this to the client.
GEMINI_API_KEY=

# Default Gemini model. Override per-endpoint if needed.
GEMINI_MODEL=gemini-2.0-flash

# --- Paymob ------------------------------------------------------------------
# Replaces deprecated `functions.config().paymob.*` values.
PAYMOB_API_KEY=
PAYMOB_HMAC_SECRET=
PAYMOB_INTEGRATION_ID=
PAYMOB_IFRAME_ID=

# --- App URLs ----------------------------------------------------------------
APP_DOMAIN=
APP_RETURN_URL=

# --- Subscription period overrides (optional) --------------------------------
SUBS_MONTH_DAYS=30
SUBS_YEAR_DAYS=365

# --- CORS --------------------------------------------------------------------
# Comma-separated list of allowed origins for HTTPS-callable functions
# served via onRequest (webhooks, custom HTTP endpoints).
# Example: https://dietin-web.web.app,https://dietin-web.firebaseapp.com
ALLOWED_ORIGINS=
