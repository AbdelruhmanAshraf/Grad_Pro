# =========================================================================
# Dietin — Frontend environment template (Vite)
# Copy to .env.development / .env.production and fill values. NEVER COMMIT.
# =========================================================================
#
# Rule of thumb: only PUBLIC-safe values belong on the frontend.
# Any VITE_* value is inlined into the built browser bundle and CAN be read
# by anyone who loads the app. Server keys must live in the FastAPI backend
# env (see the "Backend" block at the bottom for reference — those are NOT
# read by the frontend build; they live on DigitalOcean's app spec).

# --- Firebase Web SDK config -------------------------------------------------
# From Firebase Console > Project Settings > Web app.
# The apiKey identifies the project — auth is enforced by Firebase Security
# Rules server-side. Restrict the key via API-key restrictions in GCP anyway.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- AI backend (FastAPI on DigitalOcean) -----------------------------------
# Base URL of the FastAPI serving layer under Dietin/ai/exercise_recognition/inference.
# This host now serves both /api/session/* (exercise coach) and /api/llm/chat
# (Kimi 2.5 proxy). Frontend must NEVER hold the Kimi key directly.
#   Local dev:  http://localhost:8000
#   Production: https://your-deployed-api.example.com
VITE_AI_BACKEND_URL=

# =========================================================================
# Backend (FastAPI) env — for reference only. DO NOT put these in a VITE_ file.
# Set them on the DigitalOcean app spec / server environment.
# =========================================================================
# DO_AGENT_KEY=
# DO_AGENT_ENDPOINT=https://api.mistral.ai/v1
# DO_AGENT_MODEL=pixtral-12b
# AI_CORS_ORIGINS=https://dietin.app,https://www.dietin.app
# GOOGLE_APPLICATION_CREDENTIALS=/etc/dietin/firebase-admin.json
# AI_ALLOW_ANONYMOUS=0
# APP_ENV=production
# AI_MAX_BODY_BYTES=4194304
# AI_MAX_FRAME_BYTES=1048576
# AI_RATE_LLM_WINDOW=60
# AI_RATE_LLM_LIMIT=10
