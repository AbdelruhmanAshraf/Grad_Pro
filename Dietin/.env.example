# =========================================================================
# Dietin — Frontend environment template (Vite)
# Copy to .env.development / .env.production and fill values. NEVER COMMIT.
# =========================================================================

# --- Firebase Web SDK config -------------------------------------------------
# These values come from Firebase Console > Project Settings > Web app.
# The apiKey is NOT a secret (Firebase enforces auth via Security Rules),
# but should still be restricted via API key restrictions in Google Cloud.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- AI Coach (FastAPI Exercise Recognition) ---------------------------------
# Base URL of the FastAPI server in Dietin/ai/exercise_recognition/inference.
# Local dev:   http://localhost:8000
# Production:  https://your-deployed-api.example.com
# Leave EMPTY to disable the AI Coach page (renders a "coming soon" empty state).
VITE_AI_API_URL=

# --- Optional: Build-time flags ---------------------------------------------
# VITE_ENABLE_DEBUG=false

# --- Gemini API -------------------------------------------------------------
VITE_GEMINI_API_KEY=
VITE_GEMINI_MODEL_FOOD=gemini-1.5-pro
VITE_GEMINI_MODEL_LITE=gemini-1.5-flash
